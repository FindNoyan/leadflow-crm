# Copy these values from your own Supabase project.
# Supabase dashboard: Project Settings -> API.
# Never commit real keys. These are placeholders only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only AI key for the app/api/ai/* routes. Never use a NEXT_PUBLIC_
# variable for this key, and never commit a real key. Get a free key from
# Google AI Studio and set it in Vercel (Project Settings -> Environment
# Variables) for Production. Without it, the app returns clearly labelled
# demo answers and demo drafts instead of calling Gemini.
GEMINI_API_KEY=
